{
  "name": "@weivel/typescript",
  "version": "0.1.0",
  "private": true,
  "description": "The TypeScript language implementation of weivel, a binding of the C core and the C standard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./handles": {
      "types": "./dist/handles/index.d.ts",
      "default": "./dist/handles/index.js"
    },
    "./timer": {
      "types": "./dist/timer/index.d.ts",
      "default": "./dist/timer/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./standard": {
      "types": "./dist/standard/index.d.ts",
      "default": "./dist/standard/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./benchmarks": {
      "types": "./dist/benchmarks/index.d.ts",
      "default": "./dist/benchmarks/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/native.ts && tsc",
    "test": "node scripts/native.ts && tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
